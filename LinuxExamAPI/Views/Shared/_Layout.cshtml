@using LinuxExamAPI.StaticClass
<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    @if (AppSettingsKeys.IsWindows)
    {
        <link rel="shortcut icon" href="~/favicon.ico" />
        <link href="~/bootstrap_5_0_2/css/bootstrap.min.css" rel="stylesheet" />
        <link href="~/css/Custom.css" rel="stylesheet" />
    }
    else
    {
        <link href="/@AppSettingsKeys.ApiURI/bootstrap_5_0_2/css/bootstrap.min.css" rel="stylesheet" />
        <link href="/@AppSettingsKeys.ApiURI/css/Custom.css" rel="stylesheet" />
    }

    @await RenderSectionAsync("styles", required: false)
</head>
<body>
    <div class="container content-filter">
        <div class="container lay">
            <center class="blink">Linux Exam API</center>
            @RenderBody()
        </div>
        <hr>
        <footer>
            <p class="body-content" style="font-size: xx-small">
                &copy; @DateTime.Now.Year - NAAS Solutions Ltd.
            </p>
        </footer>
    </div>
</body>
</html>
